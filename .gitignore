# Personal, machine-local instructions — never shared
CLAUDE.local.md
.claude/settings.local.json

# Worktrees created by EnterWorktree. Transient by design: each one is a linked
# checkout that merge-worktree removes once its branch has landed.
.claude/worktrees/

# Python bytecode from skills/commit/scripts/
__pycache__/
*.py[cod]

# Installed copy of skills/commit/hooks/commit-msg, reinstalled per clone by
# the commit skill. Only this one file is ignored: core.hooksPath aims the
# whole repo at .githooks/, so ignoring the directory would swallow a shared
# hook someone adds there later.
.githooks/commit-msg

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.swp
